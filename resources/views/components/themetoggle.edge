<button
  type="button"
  class="icon-btn"
  title="Basculer clair / sombre"
  aria-label="Basculer entre le thème clair et sombre"
  x-data="{ t: document.documentElement.dataset.theme }"
  @click="t = t === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = t; localStorage.setItem('betplus-theme', t)"
>
  <svg x-show="t === 'dark'" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
  <svg x-show="t === 'light'" x-cloak width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>
