@layout({ title: 'BetPlus — Événements' })
  <div class="section-page">
    <div class="section-head">
      <div>
        <h1>{{ day.title }}</h1>
        <p>{{ total }} matchs de football{{ day.isToday ? " aujourd'hui" : '' }}, heures de Paris.</p>
      </div>
      <form class="day-nav" method="get" action="/evenements">
        @if(filter !== 'tous')
          <input type="hidden" name="statut" value="{{ filter }}" />
        @end
        @if(day.previous)
          <a class="day-arrow" href="/evenements?date={{ day.previous }}{{ filter !== 'tous' ? '&statut=' + filter : '' }}" aria-label="Jour précédent">‹</a>
        @else
          <span class="day-arrow disabled">‹</span>
        @end
        <label class="day-pick">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span>{{ day.label }}</span>
          <input type="date" name="date" value="{{ day.date }}" min="{{ day.min }}" max="{{ day.max }}" onclick="this.showPicker && this.showPicker()" onchange="this.form.submit()" aria-label="Choisir un jour" />
        </label>
        @if(day.next)
          <a class="day-arrow" href="/evenements?date={{ day.next }}{{ filter !== 'tous' ? '&statut=' + filter : '' }}" aria-label="Jour suivant">›</a>
        @else
          <span class="day-arrow disabled">›</span>
        @end
        @if(!day.isToday)
          <a class="day-today" href="/evenements{{ filter !== 'tous' ? '?statut=' + filter : '' }}">Aujourd'hui</a>
        @end
      </form>
    </div>
    <div class="chip-row">
      <a href="/evenements?date={{ day.date }}" class="chip {{ filter === 'tous' ? 'active' : '' }}">Tous</a>
      @if(day.isToday)
        <a href="/evenements?date={{ day.date }}&statut=live" class="chip {{ filter === 'live' ? 'active' : '' }}">En direct</a>
      @end
      <a href="/evenements?date={{ day.date }}&statut=a-venir" class="chip {{ filter === 'a-venir' ? 'active' : '' }}">À venir</a>
      <a href="/evenements?date={{ day.date }}&statut=termines" class="chip {{ filter === 'termines' ? 'active' : '' }}">Terminés</a>
    </div>
    @if(loadFailed)
      <p class="placeholder-note day-error">Impossible de charger les matchs de ce jour pour le moment. Réessaie dans quelques minutes.</p>
    @end
    @if(competitions.length)
      <div class="list-card">
        @each(competition in competitions)
          <div class="group-head">
            @!crest({ src: competition.logo, name: competition.name, class: 'crest-sm' })
            <span>{{ competition.name }}</span>
          </div>
          @each(match in competition.matches)
            <div class="fx-row {{ match.isLive ? 'is-live' : '' }}">
              <div class="fx-time">
                <b>{{ match.kickoff ?? '–' }}</b>
                <span class="fx-status fx-{{ match.isLive ? 'live' : (match.isFinished ? 'done' : 'next') }}">{{ match.statusLabel }}</span>
              </div>
              <div class="fx-teams">
                <div class="team-line {{ match.homeLost ? 'lost' : '' }}">
                  @!crest({ src: match.homeLogo, name: match.homeTeamName })
                  <h4>{{ match.homeTeamName }}</h4>
                </div>
                <div class="team-line {{ match.awayLost ? 'lost' : '' }}">
                  @!crest({ src: match.awayLogo, name: match.awayTeamName })
                  <h4>{{ match.awayTeamName }}</h4>
                </div>
              </div>
              @if(match.hasScore && match.status !== 'notstarted')
                <div class="fx-score">
                  <b class="{{ match.homeLost ? 'lost' : '' }}">{{ match.homeScore }}</b>
                  <b class="{{ match.awayLost ? 'lost' : '' }}">{{ match.awayScore }}</b>
                </div>
              @end
            </div>
          @end
        @end
      </div>
    @else
      <div class="list-card"><div class="list-row"><p class="muted">Aucun match pour ce jour et ce filtre.</p></div></div>
    @end
  </div>
@end
