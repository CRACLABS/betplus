<header class="topbar">
  <div class="topbar-inner">
    <a href="/feed" class="brand">
      <span class="brand-mark">B+</span>
      <span>Bet<b>Plus</b></span>
    </a>

    <form class="searchbar" role="search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" placeholder="Rechercher un tipster, un match, une chaîne…" aria-label="Rechercher" />
    </form>

    <nav class="topnav">
      <a href="/feed" class="active">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
        <span class="nav-label">Accueil</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="m17 2-5 5-5-5"/></svg>
        <span class="nav-label">Chaînes</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="nav-label">Groupes</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg>
        <span class="nav-label">Profils</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        <span class="nav-label">Événements</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span class="nav-label">Messages</span>
        <span class="nav-badge">3</span>
      </a>
      <a href="#">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        <span class="nav-label">Alertes</span>
        <span class="nav-badge">7</span>
      </a>
    </nav>

    <div class="topbar-user">
      @!themetoggle()
      @if(auth.user)
        @if(auth.user.isPremium)
          <span class="premium-badge" title="Membre Premium">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M11.5 1 15 8l7.5 1-5.4 5.2 1.3 7.4-6.9-3.6-6.9 3.6 1.3-7.4L.5 9 8 8Z"/></svg>
            Premium
          </span>
        @else
          @form({ route: 'premium.subscribe', method: 'POST' })
            <button type="submit" class="btn btn-ghost" style="height:30px;padding:0 12px;font-size:12px">Passer Premium</button>
          @end
        @end
        <span class="credits-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/></svg>
          3 400 Cr
        </span>
        <div class="avatar avatar-a avatar-live" style="width:34px;height:34px;font-size:12px">{{ auth.user.initials ?? 'JD' }}</div>
        @form({ route: 'session.destroy', method: 'POST' })
          <button type="submit" class="icon-btn" title="Déconnexion">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
          </button>
        @end
      @else
        <a class="btn btn-ghost" href="/login">Connexion</a>
        <a class="btn btn-primary" href="/signup">S'inscrire</a>
      @end
    </div>
  </div>
</header>
