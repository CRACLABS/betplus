@layout({ title: 'BetPlus — Les pronostics qui prouvent', nav: 'public' })
  <div class="landing">

    {{-- ================================ HERO ================================ --}}
    <section class="hero-landing">
      <div>
        <h1>Les pronos qui <em>prouvent</em>, pas ceux qui promettent.</h1>
        <p class="hero-sub">
          BetPlus est le réseau social des pronostiqueurs. Chaque tipster est noté sur ses
          résultats réels : taux de réussite, ROI, historique vérifiable. Tu suis les meilleurs,
          tu copies leurs paris, tu encaisses.
        </p>
        <div class="hero-cta">
          <a href="/signup" class="btn btn-primary">Créer mon compte gratuit</a>
          <a href="/login" class="btn btn-ghost">J'ai déjà un compte</a>
        </div>
        <div class="hero-proof">
          <div class="avatars-stack">
            <div class="avatar avatar-b">MK</div>
            <div class="avatar avatar-c">SL</div>
            <div class="avatar avatar-d">KB</div>
            <div class="avatar avatar-e">ND</div>
          </div>
          <span>Rejoins la communauté des tipsters vérifiés</span>
        </div>
      </div>

      <div class="hero-preview">
        <div class="floating-stat">
          <div class="fs-label">Réussite</div>
          <div class="fs-value">+74%</div>
        </div>
        @betcard({
          author: { name: 'Maxime K.', initials: 'MK', color: 'avatar-b', verified: true, handle: '@maximek', time: '3 min' },
          match: { competition: 'Ligue 1 · Journée 26', home: 'Paris SG', away: 'Marseille', homeCrest: 'PSG', awayCrest: 'OM', homeColor: '#1d3f73', awayColor: '#2d7ecf', live: true, minute: "67'" },
          pick: { label: 'Victoire PSG & +2,5 buts', cote: '2.40', confidence: 78, status: 'live' },
          analysis: 'Le PSG reste sur <b>7 victoires consécutives à domicile</b> et l\'OM arrive avec une défense décimée. Je valide le combo.',
          stats: { likes: 248, comments: 42, views: 3200, win: '+140 Cr' }
        })
        @end
      </div>
    </section>

    {{-- =========================== COMMENT ÇA MARCHE =========================== --}}
    <section class="landing-section">
      <h2>Comment ça marche</h2>
      <p class="section-sub">Trois étapes entre toi et des paris mieux éclairés.</p>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-icon">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <h3>Trouve les bons tipsters</h3>
          <p>Classements transparents par sport : taux de réussite, ROI et historique de chaque pronostiqueur, vérifiables à tout moment.</p>
        </div>
        <div class="step-card">
          <div class="step-icon">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </div>
          <h3>Copie leurs pronos en un clic</h3>
          <p>Chaque pronostic affiche la cote, la confiance et l'analyse. Un clic sur « Copier le pari » et il rejoint ton coupon.</p>
        </div>
        <div class="step-card">
          <div class="step-icon">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 15 4-6 4 3 5-8"/></svg>
          </div>
          <h3>Suis tes résultats</h3>
          <p>Tes paris suivis sont résolus automatiquement : gains, pertes et courbe de performance dans ton profil.</p>
        </div>
      </div>
    </section>

    {{-- ============================ PARTENAIRES ============================== --}}
    <section class="landing-section">
      <h2>Nos bookmakers partenaires</h2>
      <p class="section-sub">
        Crée ton compte chez un partenaire via nos liens et touche le bonus de bienvenue.
        Tes paris BetPlus se synchronisent ensuite automatiquement.
      </p>
      <div class="affiliate-grid">
        <div class="affiliate-card">
          <div class="affiliate-logo" style="background:#e4283c">Winamax</div>
          <div class="affiliate-bonus">Jusqu'à <b>100 €</b> offerts</div>
          <p class="affiliate-desc">Bonus de bienvenue sur ton premier dépôt + paris gratuits réguliers.</p>
          {{-- TODO: remplacer par le lien d'affiliation réel --}}
          <a href="#" class="btn btn-primary">Profiter du bonus</a>
        </div>
        <div class="affiliate-card">
          <div class="affiliate-logo" style="background:#17457c">Betclic</div>
          <div class="affiliate-bonus">Jusqu'à <b>100 €</b> remboursés</div>
          <p class="affiliate-desc">Premier pari remboursé en freebets si il est perdant.</p>
          <a href="#" class="btn btn-primary">Profiter du bonus</a>
        </div>
        <div class="affiliate-card">
          <div class="affiliate-logo" style="background:#0a7a4b">Unibet</div>
          <div class="affiliate-bonus">Jusqu'à <b>120 €</b> de bonus</div>
          <p class="affiliate-desc">Offre combinée paris sportifs + turf pour les nouveaux joueurs.</p>
          <a href="#" class="btn btn-primary">Profiter du bonus</a>
        </div>
        <div class="affiliate-card">
          <div class="affiliate-logo" style="background:#003da5">Parions Sport</div>
          <div class="affiliate-bonus">Jusqu'à <b>100 €</b> en freebets</div>
          <p class="affiliate-desc">Le bookmaker français historique, idéal pour débuter.</p>
          <a href="#" class="btn btn-primary">Profiter du bonus</a>
        </div>
      </div>
      <p class="affiliate-note">
        Liens partenaires — BetPlus peut percevoir une commission. Jouer comporte des risques : endettement, dépendance. 18+ · Jouers Info Service : 09 74 75 13 13.
      </p>
    </section>

    {{-- =============================== CTA FINAL ============================== --}}
    <section class="final-cta">
      <h2>Prêt à parier plus malin ?</h2>
      <p>Crée ton compte en 30 secondes et accède au fil complet des pronostics vérifiés.</p>
      <a href="/signup" class="btn btn-primary">Rejoindre BetPlus</a>
    </section>

    <footer class="landing-footer">
      <a href="/" class="brand" style="font-size:16px">
        <span class="brand-mark" style="width:26px;height:26px;font-size:13px">B+</span>
        <span>Bet<b>Plus</b></span>
      </a>
      <nav class="foot-links">
        <a href="#">Aide</a>
        <a href="#">À propos</a>
        <a href="#">Confidentialité</a>
        <a href="#">Règles de la communauté</a>
        <a href="#">Jeu responsable</a>
      </nav>
      <p class="copyright">BetPlus © 2026 — Pariez responsable. 18+</p>
    </footer>
  </div>
@end
